opam-version: "2.0"
synopsis: "Deterministic exchange simulator with immutable order books"
description: "A single-instrument price-time matching engine, command replay, independent model tests, and reproducible benchmarks."
maintainer: "Sanskar Jha"
authors: ["Sanskar Jha"]
license: "MIT"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "2.9"}
]
build: [["dune" "build" "-p" name "-j" jobs]]
run-test: [["dune" "runtest" "-p" name "-j" jobs]]
